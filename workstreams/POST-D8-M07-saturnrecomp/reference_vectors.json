  "semantic_edge_cases": [
    {
      "case": "signed_vs_unsigned_compare",
      "description": "0xFFFFFFFF vs 0x00000001: CMP/HS sets T=1 (unsigned 4294967295 >= 1), CMP/GE sets T=0 (signed -1 >= 1).",
      "hitachi_agreement": true,
      "mednafen_agreement": true,
      "saturnrecomp_agreement": true
    },
    {
      "case": "shift_zero_vs_sign_fill",
      "description": "0xFFFFFFFF >> 1: SHLR fills MSB with 0 (0x7FFFFFFF), SHAR fills MSB with sign bit (0xFFFFFFFF).",
      "hitachi_agreement": true,
      "mednafen_agreement": true,
      "saturnrecomp_agreement": true
    },
    {
      "case": "immediate_sign_extension",
      "description": "ADD #0xFF, Rn sign-extends 8-bit immediate to 32 bits (0xFFFFFFFF), effectively subtracting 1.",
      "hitachi_agreement": true,
      "mednafen_agreement": true,
      "saturnrecomp_agreement": true
    },
    {
      "case": "branch_target_formula",
      "description": "Target = PC + 4 + (sign_extend(disp) * 2). Verified for BF, BT, BF/S, BT/S.",
      "hitachi_agreement": true,
      "mednafen_agreement": true,
      "saturnrecomp_agreement": true
    },
    {
      "case": "delay_slot_execution",
      "description": "Instruction in delay slot of BF/S, BT/S, BRA always executes before branch target jump.",
      "hitachi_agreement": true,
      "mednafen_agreement": true,
      "saturnrecomp_agreement": true
    },
    {
      "case": "rotcl_semantics",
      "description": "Rotate left through T: new_T = MSB(Rn); new_Rn = (Rn << 1) | old_T.",
      "hitachi_agreement": true,
      "mednafen_agreement": true,
      "saturnrecomp_agreement": true
    },
    {
      "case": "div1_semantics",
      "description": "Single-step divide updates Q, M, T flags and Rn quotient bits matching hardware specification.",
      "hitachi_agreement": true,
      "mednafen_agreement": true,
      "saturnrecomp_agreement": true
    }
  ]
