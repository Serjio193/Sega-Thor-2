+template<bool EmulateICache, bool DebugMode>
+static void NativeBranchTo(uint32 target)
+{
+ CPU[0].PC = target;
+
+ uint32 delay_slot = 0x0009; // NOP
+ uint32 op = InstrDecodeTab[delay_slot];
+ CPU[0].Pipe_ID = delay_slot | ((op | 0x80) << 24);
+
+ if(EmulateICache)
+ {
+  CPU[0].UCRead_IF_Kludge = false;
+  uint32 ibuf = CPU[0].MRFPI[(CPU[0].PC & ~2) >> 29](CPU[0].PC & ~2);
+  CPU[0].IBuffer = ibuf;
+  CPU[0].Pipe_IF = (uint16)ibuf;
+  if(!(CPU[0].PC & 0x2))
+   CPU[0].Pipe_IF = ibuf >> 16;
+  CPU[0].timestamp -= (CPU[0].PC >> 1) & CPU[0].UCRead_IF_Kludge;
+ }
+ else
+ {
+  if(CPU[0].timestamp < CPU[0].MA_until)
+   CPU[0].timestamp = CPU[0].MA_until;
+  CPU[0].Pipe_IF = *(uint16*)(SH7095_FastMap[CPU[0].PC >> SH7095_EXT_MAP_GRAN_BITS] + CPU[0].PC);
+  if(MDFN_UNLIKELY((int32)CPU[0].PC < 0))
+   CPU[0].Pipe_IF = CPU[0].Cache_ReadDataArray<uint16>(CPU[0].PC);
+ }
+ CPU[0].timestamp++;
+
+ CPU[0].PC += 2;
+}
+
+template<bool EmulateICache, bool DebugMode>
+static bool Automation_TryNativeOverride(uint32_t override_pc)
+{
+ if(s_native_mode == 0)
+  return false;
+
+ if(!InitNativePluginIfNeeded() || !p_thor_native_dispatch_step)
+  return false;
+
+ if(p_thor_native_set_mode)
+  p_thor_native_set_mode(s_native_mode);
+ if(p_thor_native_set_block_mask)
+  p_thor_native_set_block_mask(s_native_block_mask);
+
+ ThorNativePluginRegs regs;
+ for(unsigned i = 0; i < 16; i++) regs.r[i] = CPU[0].R[i];
+ regs.pc = override_pc;
+ regs.sr = CPU[0].SR;
+ regs.pr = CPU[0].PR;
+ regs.gbr = CPU[0].GBR;
+ regs.vbr = CPU[0].VBR;
+ regs.mach = CPU[0].MACH;
+ regs.macl = CPU[0].MACL;
+
+ ThorNativePluginCallbacks hw;
+ hw.user_data = nullptr;
+ hw.read8 = [](uint32_t a, void*) -> uint8_t {
+  return CPU[0].MRFP8[(a) >> 29](a);
+ };
+ hw.read16 = [](uint32_t a, void*) -> uint16_t {
+  return CPU[0].MRFP16[(a) >> 29](a);
+ };
+ hw.read32 = [](uint32_t a, void*) -> uint32_t {
+  return CPU[0].MRFP32[(a) >> 29](a);
+ };
+ hw.write8 = [](uint32_t a, uint8_t v, void*) {
+  CPU[0].MWFP8[(a) >> 29](a, v);
+ };
+ hw.write16 = [](uint32_t a, uint16_t v, void*) {
+  CPU[0].MWFP16[(a) >> 29](a, v);
+ };
+ hw.write32 = [](uint32_t a, uint32_t v, void*) {
+  CPU[0].MWFP32[(a) >> 29](a, v);
+ };
+ hw.is_slave_active = [](void*) -> bool {
+  return CPU[1].timestamp != SS_EVENT_DISABLED_TS;
+ };
+ hw.is_dma_active = [](void*) -> bool {
+  return CPU[0].DMA_InBurst();
+ };
+ hw.is_irq_pending = [](void*) -> bool {
+  return (CPU[0].SR & 0xF0) != 0;
+ };
+
+ uint32_t out_target_pc = 0;
+ uint32_t out_cycles_advanced = 0;
+
+ bool handled = p_thor_native_dispatch_step(override_pc, &regs, &out_target_pc, &out_cycles_advanced, &hw);
+
+ if(p_thor_native_get_stats)
+ {
+  ThorNativePluginStats st;
+  memset(&st, 0, sizeof(st));
+  p_thor_native_get_stats(&st);
+  s_native_executed_count = st.native_executed_count;
+  s_native_fallback_count = st.fallback_count;
+  s_native_shadow_match_count = st.shadow_match_count;
+  s_native_shadow_divergence_count = st.shadow_divergence_count;
+  s_native_ineligible_count = st.ineligible_count;
+ }
+
+ if(handled && s_native_mode == 2)
+ {
+  // Commit native state to live hardware
+  for(unsigned i = 0; i < 16; i++) CPU[0].R[i] = regs.r[i];
+  CPU[0].SR = regs.sr;
+  CPU[0].PR = regs.pr;
+  CPU[0].GBR = regs.gbr;
+  CPU[0].VBR = regs.vbr;
+  CPU[0].MACH = regs.mach;
+  CPU[0].MACL = regs.macl;
+
+  sscpu_timestamp_t target_ts = CPU[0].timestamp + out_cycles_advanced;
+  NativeBranchTo<EmulateICache, DebugMode>(out_target_pc);
+  if(override_pc == 0x06004280u)
+  {
+   ShadowStack_Push(0, 0x06004286u, out_target_pc, regs.pr);
+  }
+  CPU[0].timestamp = target_ts;
+  SH7095_mem_timestamp = std::max(SH7095_mem_timestamp, target_ts);
+  CPU[0].MA_until = std::min(CPU[0].MA_until, target_ts);
+  for(unsigned i = 0; i < 16; i++) {
+   if(CPU[0].WB_until[i] > target_ts) CPU[0].WB_until[i] = target_ts;
+  }
+  return true;
+ }
+
+ return false;
+}
