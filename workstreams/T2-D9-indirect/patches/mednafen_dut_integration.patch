+static bool InitNativePluginIfNeeded()
+{
+ if(p_thor_native_dispatch_step != nullptr)
+  return true;
+
+ const char* plugin_paths[] = {
+  "/mnt/e/Github/Sega-Thor-2/build-linux-rel/libthor_native.so",
+  "/mnt/e/Github/Sega-Thor-2/build_linux_release/libthor_native.so",
+  "/mnt/e/Github/Sega-Thor-2/build_linux_debug/libthor_native.so",
+  "libthor_native.so"
+ };
+
+ for(size_t i = 0; i < sizeof(plugin_paths)/sizeof(plugin_paths[0]); i++)
+ {
+  void* h = dlopen(plugin_paths[i], RTLD_NOW | RTLD_LOCAL);
+  if(h)
+  {
+   s_native_lib_handle = h;
+   p_thor_native_init = (fn_thor_native_init)dlsym(h, "thor_native_init");
+   p_thor_native_set_mode = (fn_thor_native_set_mode)dlsym(h, "thor_native_set_mode");
+   p_thor_native_set_block_mask = (fn_thor_native_set_block_mask)dlsym(h, "thor_native_set_block_mask");
+   p_thor_native_get_block_mask = (fn_thor_native_get_block_mask)dlsym(h, "thor_native_get_block_mask");
+   p_thor_native_get_stats = (fn_thor_native_get_stats)dlsym(h, "thor_native_get_stats");
+   p_thor_native_reset_stats = (fn_thor_native_reset_stats)dlsym(h, "thor_native_reset_stats");
+   p_thor_native_get_block_stats = (fn_thor_native_get_block_stats)dlsym(h, "thor_native_get_block_stats");
+   p_thor_native_dispatch_step = (fn_thor_native_dispatch_step)dlsym(h, "thor_native_dispatch_step");
+
+   if(p_thor_native_init) p_thor_native_init();
+   return (p_thor_native_dispatch_step != nullptr);
+  }
+ }
+ return false;
+}
